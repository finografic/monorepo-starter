{
  "name": "@workspace/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "dev": "vite",
    "build": "tsc --project tsconfig.json && vite build",
    "start": "vite preview",
    "·········· ICONS": "·····················································",
    "icons:manager": "concurrently -n \"server,manager\" -c \"cyan,green\" \"icons-server\" \"lucide-manager\"",
    "icons:server": "icons-server",
    "update:icons": "pnpm update @finografic/icons --latest",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --detach",
    "·········· LINTING": "···················································",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts"
  },
  "dependencies": {
    "@finografic/icons": "^1.19.2",
    "@tanstack/react-query": "^5.101.1",
    "@workspace/ui": "workspace:*",
    "hono": "^4.12.27",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@finografic/lucide-manager": "^0.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
